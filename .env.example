# ---------------------------------------------------------------------------
# Tracer environment variables
# Copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------

# App
# Also the base for canonical links, the sitemap and link previews, so in
# production this must be the real public URL, not a preview or localhost.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (PostgreSQL on Neon)
# Create a project at https://console.neon.tech and copy the pooled connection
# string. Any PostgreSQL database works; Neon is what the client is tuned for.
DATABASE_URL=postgresql://user:password@ep-example-123456.eu-central-1.aws.neon.tech/tracer?sslmode=require

# The production branch, used only by `pnpm db:migrate:prod`. Nothing reads it
# at runtime, and no command that reshapes a schema is pointed at it.
PROD_DATABASE_URL=

# GitHub OAuth app
# Create one at https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Auth.js session secret. Generate one with: npx auth secret
AUTH_SECRET=

# GitHub API
# Optional token used for background collection, where there is no signed-in
# user whose rate limit can be borrowed. Public read scope is enough.
GITHUB_TOKEN=

# AI provider (optional, see src/server/ai)
# The AI layer is abstracted behind a service so other providers can be added
# later. Leave AI_PROVIDER=none, or the key blank, to run without it.
AI_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Shared secret for the scheduled jobs in /api/jobs/*. Required for the
# saved-opportunity refresh; any long random string will do.
CRON_SECRET=
